{
  "name": "happy-squid-obsidian",
  "version": "1.0.2",
  "description": "Start and stop Happy Squid tasks from checkboxes in your notes, and keep lasting records of your task goals, daily summaries and focus figures.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.5.7",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "license": "MIT"
}
